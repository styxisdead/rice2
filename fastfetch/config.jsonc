{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "right": 3
        },
        "color": {
            "1": "#c5c0ff",
            "2": "#c7c4dc",
            "3": "#ebb9d0",
            "4": "#444078",
            "5": "#e5e1e9",
            "6": "#464559"
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#c5c0ff",
                "at": "#c7c4dc",
                "host": "#ebb9d0"
            }
        },

        {
            "type": "separator",
            "string": "────────────────────────"
        },

        {
            "type": "os",
            "key": "OS",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#c7c4dc"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#ebb9d0"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#c7c4dc"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#ebb9d0"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#c7c4dc"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#ebb9d0"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#c7c4dc"
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
